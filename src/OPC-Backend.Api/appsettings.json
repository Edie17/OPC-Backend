{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OPC_Backend": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OpcBackend": "Server=(localdb)\\MSSQLLocalDB;Database=OpcBackend;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "OpcUa": {
    "ServerUrl": "opc.tcp://localhost:4840/opcbackend",
    "PkiRoot": "pki"
  },
  "OpcUaClient": {
    "RemoteServerUrl": "opc.tcp://opcuaserver.com:48010",
    "Enabled": true
  }
}
